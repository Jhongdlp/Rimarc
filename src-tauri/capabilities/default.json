{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "store", "clipboard", "clipboard-settings"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-minimize",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:app:default",
    "opener:default"
  ]
}
